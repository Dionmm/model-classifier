{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/router-spike hook --source claude-style",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/router-spike hook --source claude-style",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
